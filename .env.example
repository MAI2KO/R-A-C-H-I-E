# Discord application
BOT_TOKEN=replace-with-discord-bot-token
CLIENT_ID=replace-with-discord-application-id

# Existing Apps Script backend (separate for each bot/service)
APPS_SCRIPT_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec
ADMIN_API_KEY=replace-with-apps-script-admin-key

# Existing OpenAI-backed banter
OPENAI_API_KEY=replace-with-openai-api-key
BANTER_PROFILE=rachie

# Bot identity: wos/rachie-wos or kingshot/peggie-kingshot
GAME_PROFILE=wos
BOT_INSTANCE_NAME=rachie-wos

# Optional Postgres event scheduler
EVENT_SCHEDULER_ENABLED=false
DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/replace-database

# Optional canonical player-account and gift-code foundation
PLAYER_GIFT_CODES_ENABLED=false

# Optional emergency overrides for the built-in current public-client signing values
CENTURY_WOS_SIGNING_SUFFIX=
CENTURY_KINGSHOT_SIGNING_SUFFIX=
CENTURY_MINIMUM_DELAY_MS=1000
CENTURY_MAXIMUM_RETRIES=2
CENTURY_BACKOFF_BASE_MS=2000
CENTURY_BACKOFF_CAP_MS=60000

# Optional scheduler tuning (shown with code defaults)
EVENT_SCHEDULER_LOOKAHEAD_MINUTES=1440
EVENT_SCHEDULER_GRACE_MINUTES=60
EVENT_SCHEDULER_POLL_INTERVAL_MS=30000
EVENT_SCHEDULER_BATCH_SIZE=10
EVENT_SCHEDULER_CLAIM_LEASE_SECONDS=60
EVENT_SCHEDULER_HANDLER_TIMEOUT_MS=30000

# Test-only disposable Postgres database
TEST_DATABASE_URL=postgresql://replace-user:replace-password@127.0.0.1:5432/replace-disposable-database
