# Discord application
BOT_TOKEN=replace-with-discord-bot-token
CLIENT_ID=replace-with-discord-application-id

# Existing Apps Script backend (separate for each bot/service)
APPS_SCRIPT_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec
# Optional responsibility-specific overrides; blank values fall back to APPS_SCRIPT_URL
BOOKING_APPS_SCRIPT_URL=
STATE_APPS_SCRIPT_URL=
CONFIG_APPS_SCRIPT_URL=
BANTER_APPS_SCRIPT_URL=
ADMIN_API_KEY=replace-with-apps-script-admin-key

# Existing OpenAI-backed banter
OPENAI_API_KEY=replace-with-openai-api-key
BANTER_PROFILE=rachie

# Bot identity: wos/rachie-wos or kingshot/peggie-kingshot
GAME_PROFILE=wos
BOT_INSTANCE_NAME=rachie-wos

# Optional native-booking website Discord delivery. Keep false until the
# matching profile hostname/secret is configured and Server Members Intent is enabled.
BOOKING_WEBSITE_INTEGRATION_ENABLED=false
BOOKING_WEBSITE_BASE_URL=https://replace-with-profile-specific-website-hostname
BOOKING_WEBSITE_INTEGRATION_SECRET=replace-with-at-least-32-random-characters
BOOKING_WEBSITE_POLL_INTERVAL_MS=10000

# Optional Postgres event scheduler
EVENT_SCHEDULER_ENABLED=false
DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/replace-database

# Optional signed, read-only website bridge for public State/Kingdom alliance schedules.
# Keep disabled until a matching website-only secret and private HTTPS URL are configured.
ALLIANCE_EVENTS_READ_ENABLED=false
ALLIANCE_EVENTS_READ_SECRET=replace-with-at-least-32-random-characters
# Defaults to Railway PORT, then 3000. Set explicitly only when the service needs it.
ALLIANCE_EVENTS_READ_PORT=

# Optional canonical player-account and gift-code foundation
PLAYER_GIFT_CODES_ENABLED=false
# Comma-separated Discord user IDs allowed to perform global ownership recovery
BOT_OWNER_IDS=

# Live Century workflows are independently disabled until explicitly enabled
GIFT_CODE_VERIFICATION_ENABLED=false
GIFT_CODE_REDEMPTION_WORKER_ENABLED=false
GIFT_CODE_MAX_AUTO_REDEEM_ACCOUNTS_PER_USER=2
WOS_GIFT_VERIFY_FID=
WOS_GIFT_VERIFY_KID=
KINGSHOT_GIFT_VERIFY_FID=
KINGSHOT_GIFT_VERIFY_KID=
GIFT_CODE_WORKER_POLL_INTERVAL_MS=10000
GIFT_CODE_CLAIM_LEASE_SECONDS=120
GIFT_CODE_MAX_ATTEMPTS=5
GIFT_CODE_RETRY_BASE_SECONDS=60
GIFT_CODE_RETRY_CAP_SECONDS=3600

# Optional discovery sources; catalogue polling is off unless both gates are enabled
GIFT_CODE_SOURCE_POLLING_ENABLED=false
WOS_REWARDS_SOURCE_ENABLED=false
KINGSHOT_REWARDS_SOURCE_ENABLED=false
GIFT_CODE_SOURCE_POLL_INTERVAL_SECONDS=900

# Optional emergency overrides for the built-in current public-client signing values
CENTURY_WOS_SIGNING_SUFFIX=
CENTURY_KINGSHOT_SIGNING_SUFFIX=
CENTURY_MINIMUM_DELAY_MS=1000
CENTURY_MAXIMUM_RETRIES=2
CENTURY_BACKOFF_BASE_MS=2000
CENTURY_BACKOFF_CAP_MS=60000

# Optional scheduler tuning (shown with code defaults)
EVENT_SCHEDULER_LOOKAHEAD_MINUTES=1440
EVENT_SCHEDULER_GRACE_MINUTES=60
EVENT_SCHEDULER_POLL_INTERVAL_MS=30000
EVENT_SCHEDULER_BATCH_SIZE=10
EVENT_SCHEDULER_CLAIM_LEASE_SECONDS=60
EVENT_SCHEDULER_HANDLER_TIMEOUT_MS=30000

# Test-only disposable Postgres database
TEST_DATABASE_URL=postgresql://replace-user:replace-password@127.0.0.1:5432/replace-disposable-database
